{
  "name": "chm-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "TageCode <tagecode@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tagecode/chm-assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/tagecode/chm-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/tagecode/chm-assistant/issues"
  },
  "description": "CHM Assistant — Electron desktop app (Vite, React, TypeScript, Tailwind CSS, shadcn/ui).",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "native:configure": "node-gyp configure --directory native",
    "native:build": "node-gyp configure build --directory native",
    "native:rebuild": "node scripts/electron-native-rebuild.mjs",
    "compilers:stage": "node scripts/stage-compilers.mjs",
    "icons:generate": "bash scripts/generate-icons.sh",
    "dist:prepare": "pnpm run native:rebuild",
    "dist": "pnpm run dist:prepare && pnpm run compilers:stage && pnpm run build && electron-builder",
    "dist:mac": "pnpm run dist:prepare && pnpm run compilers:stage && pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run dist:prepare && pnpm run compilers:stage && pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run dist:prepare && pnpm run compilers:stage && pnpm run build && electron-builder --linux",
    "dist:ci": "node scripts/ci-package.mjs",
    "test:chm-nav-encoding": "node scripts/tests/chm-nav-encoding.mjs",
    "test:chm-hhp-paths": "node scripts/tests/chm-hhp-paths.mjs",
    "test:mvp": "node scripts/mvp-acceptance/run.mjs",
    "test:mvp:static": "node scripts/mvp-acceptance/run.mjs -- --static-only --no-build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "electron-store": "^11.0.2",
    "iconv-lite": "^0.6.3",
    "markdown-it": "^14.1.1",
    "monaco-editor": "^0.55.1",
    "node-html-parser": "^7.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.577.0",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^12.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.tagecode.chm-assistant",
    "productName": "CHM Assistant",
    "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 TageCode",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/chm_addon.node",
        "to": "native/chm_addon.node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/compilers/${os}-${arch}",
        "to": "compilers/${os}-${arch}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
