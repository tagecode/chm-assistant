# Dependencies
node_modules/

# Build outputs (Vite / TypeScript / Electron)
dist/
dist-ssr/
dist-electron/
release/

# Native addon (rebuilt via pnpm run native:rebuild)
native/build/

# Test / acceptance artifacts (regenerated by pnpm run test:mvp)
test-results/

# Bundled compilers (staged at pack time via pnpm run compilers:stage)
resources/compilers/**/chmcmd
resources/compilers/**/chmcmd.exe

# NOTE: build/ is intentionally tracked — electron-builder icons for cross-platform CI
# NOTE: resources/icons/icon.png is the source; build/ holds generated .icns/.ico/.png

# Environment & secrets
.env
.env.*
!.env.example
electron-builder.env
*.pem
*.p12
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local overrides
*.local

# TypeScript incremental build info
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cursor (local IDE state)
.cursor/
